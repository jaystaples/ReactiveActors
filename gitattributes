# Let Git normalise line endings for anything not listed below
* text=auto

# Unreal assets are binary: store them with Git LFS (run "git lfs install" once per machine)
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.wav    filter=lfs diff=lfs merge=lfs -text

# Source and config: normal text, Windows line endings kept as committed
*.h      text
*.cpp    text
*.cs     text
*.ini    text
*.md     text
*.uplugin text
*.svg    text
